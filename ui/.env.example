# Copy to .env, fill in the top block, and load it in EVERY terminal you use:
#     set -a; source .env; set +a
# The docs in docs/ say which of the lower values to fill in as you create things.
PREFIX=researchassistant
PROJECT=ResearchAssistant
REGION=us-east-1
ACCOUNT_ID=
TEST_USER1=user1
TEST_USER2=user2
TEST_USER3=user3
TEST_PASSWORD=change-me

# ---- filled in as you build ----
POOL_ID=
CLIENT_ID=
DISCOVERY_URL=
BUCKET=
KB_ID=
DATA_SOURCE_ID=
GUARDRAIL_ID=
GUARDRAIL_VERSION=
GATEWAY_ID=
GATEWAY_URL=
INTERCEPTOR_ARN=
RUNTIME_ARN=

# Optional: the user the evaluation runner signs in as (default TEST_USER1)
EVAL_USERNAME=
