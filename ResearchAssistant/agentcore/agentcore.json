{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "ResearchAssistant",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "ResearchAssistant"
  },
  "runtimes": [
    {
      "name": "ResearchAssistantAgent",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/ResearchAssistantAgent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "requestHeaderAllowlist": [
        "Authorization"
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YB2NDA4AZ/.well-known/openid-configuration",
          "allowedClients": [
            "6m02c6vst9mnevbdnbfl3qlnik"
          ]
        }
      },
      "envVars": [
        {
          "name": "GUARDRAIL_ID",
          "value": "wizgzu2pctpi"
        },
        {
          "name": "GUARDRAIL_VERSION",
          "value": "1"
        }
      ],
      "additionalPolicies": [
        "policies/allow_guardrails.json"
      ]
    }
  ],
  "memories": [
    {
      "name": "ResearchAssistantAgentMemory",
      "eventExpiryDuration": 30,
      "strategies": []
    }
  ],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [
    {
      "name": "researchassistant-gw",
      "protocolType": "MCP",
      "description": "Gateway for researchassistant-gw",
      "targets": [
        {
          "name": "researchassistant",
          "targetType": "lambdaFunctionArn",
          "lambdaFunctionArn": {
            "lambdaArn": "arn:aws:lambda:us-east-1:716643470956:function:researchassistant-tools",
            "toolSchemaFile": "../lambda/tool_schema.json"
          }
        }
      ],
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YB2NDA4AZ/.well-known/openid-configuration",
          "allowedClients": [
            "6m02c6vst9mnevbdnbfl3qlnik"
          ]
        }
      },
      "enableSemanticSearch": true,
      "exceptionLevel": "NONE",
      "policyEngineConfiguration": {
        "policyEngineName": "ResearchAssistantPolicyEngine",
        "mode": "ENFORCE"
      }
    }
  ],
  "policyEngines": [
    {
      "name": "ResearchAssistantPolicyEngine",
      "policies": [
        {
          "name": "allow_all_tools",
          "statement": "permit (\n  principal,\n  action,\n  resource is AgentCore::Gateway\n);",
          "sourceFile": "../policies/allow_all_tools.cedar",
          "validationMode": "IGNORE_ALL_FINDINGS",
          "enforcementMode": "ACTIVE",
          "authorizationPhase": "INITIATE"
        }
      ]
    }
  ],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}
